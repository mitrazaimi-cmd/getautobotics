# ──────────────────────────────────────────────────────────────────────────────
# Auto Botics — environment variables
# Copy this file to `.env` for local development. In production, add the same
# keys in Vercel → Project → Settings → Environment Variables.
# Never commit `.env`.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon: Dashboard → Connection Details → "Pooled connection").
# Local alternative: run `npx prisma dev` and paste the TCP URL it prints.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Only needed if `prisma migrate dev` can't create a temporary database (not needed on Neon).
# SHADOW_DATABASE_URL=""

# Public site URL, without a trailing slash. Used for links in emails, sitemap, and SEO.
NEXT_PUBLIC_SITE_URL="https://getautobotics.com"

# ── Admin panel (/admin) ──────────────────────────────────────────────────────
# Encrypts the admin session cookie. At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# The only account that can sign in.
ADMIN_EMAIL="you@getautobotics.com"

# scrypt hash of the admin password — never the plain password.
# Generate: npm run hash-password -- "your long, unique password"
ADMIN_PASSWORD_HASH=""

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Leave empty during development: emails are printed to the terminal instead of sent.
RESEND_API_KEY=""

# Sender. The domain must be verified in Resend (DNS records).
EMAIL_FROM="Auto Botics <hello@getautobotics.com>"

# Where visitor replies go (usually your inbox).
EMAIL_REPLY_TO="you@getautobotics.com"

# Who gets "new consultation request" notifications. Defaults to ADMIN_EMAIL.
ADMIN_NOTIFY_EMAIL="you@getautobotics.com"

# ── Reminders cron ────────────────────────────────────────────────────────────
# Protects GET /api/cron/reminders. Random string, at least 24 characters.
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# Optional: salt for hashing visitor IPs in rate limiting. Defaults to SESSION_SECRET.
# RATE_LIMIT_SALT=""
