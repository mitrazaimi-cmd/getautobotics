// Auto Botics — database schema
// Connection URL lives in prisma.config.ts (Prisma 7), read from DATABASE_URL.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  NEW
  CONTACTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CompanySize {
  SIZE_1_5
  SIZE_6_20
  SIZE_21_50
  SIZE_51_PLUS
}

enum Challenge {
  EMAIL_FOLLOWUP
  LEAD_RESPONSE
  SCHEDULING
  CUSTOMER_SUPPORT
  WORKFLOWS
  OTHER
}

model ConsultationRequest {
  id               String        @id @default(cuid())
  fullName         String
  email            String
  phone            String?
  companyName      String
  companySize      CompanySize
  mainChallenge    Challenge
  description      String        @db.Text
  /// Free text from the visitor, including their time zone
  preferredTimes   String?
  referralSource   String?
  /// When the visitor gave consent to store data and receive emails
  consentAt        DateTime
  status           RequestStatus @default(NEW)
  /// Always stored in UTC
  scheduledAt      DateTime?
  /// IANA time zone of the visitor, e.g. "America/New_York"
  timezone         String?
  /// Video call link or joining details, included in the invite and reminders
  meetingLink      String?
  /// Bumped on every reschedule/cancel so calendar apps update the same event
  icsSequence      Int           @default(0)
  adminNotes       String?       @db.Text
  reminder24SentAt DateTime?
  reminder1SentAt  DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([scheduledAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

/// Fixed-window rate limit counters. Stored in Postgres so limits hold
/// across serverless instances without an extra service.
model RateLimit {
  key       String   @id
  count     Int
  windowEnd DateTime
}
